# Copy to deploy/.env before starting the stack.

# Pin to a stable LiteLLM image tag once validated in the target env.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
LITELLM_PORT=4000
LITELLM_NUM_WORKERS=4

# RDS-backed persistence for LiteLLM users, keys, budgets, spend logs, etc.
LITELLM_DATABASE_URL=postgresql://USERNAME:PASSWORD@RDS_HOST:5432/litellm

# Must start with sk-
LITELLM_MASTER_KEY=sk-change-me

# Provider credentials
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
